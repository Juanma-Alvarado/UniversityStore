NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key. Solo server (pedidos y eventos de Wompi).
SUPABASE_SECRET_KEY=

# Wompi (pagos en COP con PSE, tarjetas y Nequi): comercios.wompi.co → Desarrolladores.
# Con llaves de prueba (pub_test_...) todo va al sandbox.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# WhatsApp de la tienda para tus productos propios (indicativo + número, solo dígitos).
# Vacío = sin botón. Los emprendimientos usan su propio número (ventures.whatsapp).
STORE_WHATSAPP=

# dominio real una vez deployado (sin barra final). Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
