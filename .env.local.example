NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key. Solo server (webhook de Stripe).
SUPABASE_SECRET_KEY=

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# En local sale de `stripe listen --forward-to localhost:3000/api/stripe/webhook`;
# en producción, de Developers → Webhooks en el dashboard de Stripe.
STRIPE_WEBHOOK_SECRET=

# dominio real una vez deployado (sin barra final). Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
